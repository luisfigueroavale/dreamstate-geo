{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "page_type",
    "query",
    "primary_keyword",
    "reader",
    "answer",
    "sections",
    "sources",
    "internal_links",
    "conversion_link"
  ],
  "properties": {
    "page_type": { "enum": ["compare", "roundup", "how-to"] },
    "query": { "type": "string", "minLength": 1 },
    "primary_keyword": { "type": "string", "minLength": 1 },
    "reader": { "type": "string", "minLength": 1 },
    "answer": { "type": "string", "minLength": 1 },
    "our_product": { "type": "string" },
    "named_product": { "type": "string" },
    "named_product_url": { "type": "string" },
    "task": { "type": "string" },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "note": { "type": "string" }
        }
      }
    },
    "sections": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 1 } },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "fact", "date_read"],
        "properties": {
          "url": { "type": "string", "minLength": 8 },
          "fact": { "type": "string", "minLength": 1 },
          "date_read": { "type": "string", "minLength": 10 }
        }
      }
    },
    "internal_links": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
    "conversion_link": { "type": "string", "minLength": 1 },
    "never_claim": { "type": "array", "items": { "type": "string" } },
    "fictional": { "type": "boolean" },
    "note": { "type": "string" }
  }
}
